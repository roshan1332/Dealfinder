# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. `npm run db:local` starts a local Postgres on port 5433
# that matches this default, if you don't have Postgres or Docker installed.
DATABASE_URL="postgresql://dealfinder:dealfinder@localhost:5433/dealfinder?schema=public"

# ─── Auth (Auth.js) ──────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="2/QmhLZLAHeBcubUiyicgH2Q1AXjiudCWmMoVRL0DJQ="
# Set to true when self-hosting behind a proxy (Vercel sets this automatically)
AUTH_TRUST_HOST=true

# Initial admin account created by `npm run db:seed` (change the password!)
SEED_ADMIN_EMAIL="admin@dealfinder.local"
SEED_ADMIN_PASSWORD="ChangeMe-Admin-123"

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Bearer token required by /api/cron/sync and /api/cron/check-alerts
CRON_SECRET="b536ae65508641de153418611be85c6bef9ee1a91e306e9b"

# ─── Data sources ────────────────────────────────────────────────────────────
# Set to "true" to show the fictional demo stores (development only).
ENABLE_MOCK_PROVIDERS=false
# Live Nepali stores (src/lib/providers/live/stores.ts). Set to "false" to turn them off.
ENABLE_LIVE_PROVIDERS=true
# Hours before a store page is re-read on the next sync (default 12).
LIVE_REFRESH_HOURS=12
# Example placeholders for real providers (server-side only - never prefix with NEXT_PUBLIC_)
# EXAMPLE_AFFILIATE_API_KEY=""
# EXAMPLE_AFFILIATE_TRACKING_ID=""
# EXAMPLE_MERCHANT_FEED_URL=""

# ─── Notifications ───────────────────────────────────────────────────────────
# If set, price-drop alerts are emailed through Resend. Otherwise they are logged to the server console.
# RESEND_API_KEY=""
# ALERT_FROM_EMAIL="DealFinder <alerts@your-domain.com>"

# ─── Image recognition ───────────────────────────────────────────────────────
# Leave empty to use the demo recognizer. Plug a real vision API into src/lib/image-recognition.
# IMAGE_RECOGNITION_API_KEY=""
